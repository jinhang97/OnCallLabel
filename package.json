{
  "name": "oncall-label",
  "productName": "随时标签 OnCallLabel",
  "version": "1.0.2",
  "description": "桌面悬浮标签：在桌面上不透明度100%，其他窗口前置时自动降低不透明度；Ctrl+双击编辑、鼠标拖动移动、Ctrl+拖动边缘调整大小；支持主题。",
  "main": "main.js",
  "author": "OnCallLabel",
  "license": "MIT",
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "pack": "node node_modules/electron-builder/cli.js --win --dir",
    "dist:portable": "node node_modules/electron-builder/cli.js --win portable --prepackaged dist/win-unpacked",
    "dist": "node node_modules/electron-builder/cli.js --win --dir & node node_modules/electron-builder/cli.js --win portable --prepackaged dist/win-unpacked"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "koffi": "^2.9.2"
  },
  "build": {
    "appId": "com.oncalllabel.app",
    "productName": "OnCallLabel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "themes/**/*",
      "node_modules/**/*",
      "!node_modules/**/{CHANGELOG.md,README.md,readme.md,*.d.ts,*.map,*.ts}",
      "!node_modules/**/{test,tests,__tests__,docs,doc,examples,example}/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "OnCallLabel-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "OnCallLabel-${version}-portable.exe"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ]
  }
}
